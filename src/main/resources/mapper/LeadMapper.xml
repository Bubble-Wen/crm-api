<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.crm.mapper.LeadMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.crm.entity.Lead">
        <id column="id" property="id" />
        <result column="name" property="name" />
        <result column="phone" property="phone" />
        <result column="email" property="email" />
        <result column="level" property="level" />
        <result column="source" property="source" />
        <result column="address" property="address" />
        <result column="follow_status" property="followStatus" />
        <result column="next_follow_status" property="nextFollowStatus" />
        <result column="remark" property="remark" />
        <result column="owner_id" property="ownerId" />
        <result column="status" property="status" />
        <result column="delete_flag" property="deleteFlag" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
    </resultMap>

    <!-- 根据创建时间范围统计线索数量 -->
    <select id="countByCreateTime" resultType="int">
        SELECT COUNT(*)
        FROM lead
        <where>
            <if test="startTime != null and startTime != ''">
                AND create_time >= #{startTime}
            </if>
            <if test="endTime != null and endTime != ''">
                AND create_time <![CDATA[ <= ]]> #{endTime}
            </if>
        </where>
    </select>


</mapper>
